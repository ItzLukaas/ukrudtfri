# Database (lokal: kør `docker compose up -d` og brug denne URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ukrudtfri?schema=public"

# Auth (NextAuth v5)
AUTH_SECRET="generer-en-lang-tilfaeldig-streng"
NEXTAUTH_SECRET="valgfri-fallback"

# App URL (til auth redirects)
NEXTAUTH_URL="http://localhost:3000"

# Offentlig site-URL (bruges bl.a. til iCal-feed-link i admin — skal matche produktion)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (vælg ÉN løsning) ---
#
# A) Self-hosted Umami (anbefalet — gratis, enkel, Plausible-lignende UI).
#    Nemmest: separat Vercel-projekt + Postgres (Neon/Supabase) — se README + https://umami.is/docs/guides/running-on-vercel
#    Domæne fx stats.ukrudtfri.dk → derefter i Umami: Websites → tilføj "ukrudtfri.dk" → kopier Website ID hertil.
#    Alternativ: docker/umami.compose.yaml på egen VPS.
NEXT_PUBLIC_UMAMI_URL="https://stats.ukrudtfri.dk"
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# Umami-bruger til /admin/statistik (server-only — aldrig NEXT_PUBLIC). Opret i Umami eller brug admin.
UMAMI_USERNAME=""
UMAMI_PASSWORD=""
# Valgfrit hvis API ligger et andet sted end script-URL (sjældent).
# UMAMI_API_URL="https://stats.ukrudtfri.dk"
# Valgfrit hvis kun server må kende website-id (ellers bruges NEXT_PUBLIC_UMAMI_WEBSITE_ID).
# UMAMI_WEBSITE_ID=""
#
# B) Self-hosted Plausible Community Edition (samme snippet som cloud, eget script-domæne).
#    Brug IKKE samtidig med Umami (så slår du A fra ved at fjerne UMAMI_*).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="ukrudtfri.dk"
# NEXT_PUBLIC_PLAUSIBLE_SRC="https://stats.ukrudtfri.dk/js/script.js"
# Valgfrit kun hvis du bruger Plausible cloud igen: filnavn under /js/
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT="script.outbound-links.js"

# --- Meta (Facebook) Pixel ---
# Find dit Pixel-ID under Meta Events Manager → Indstillinger → Pixel-ID (kun tal).
# I produktion indlæses pixel med Cookiebot marketing-samtykke (type text/plain).
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Cookiebot (GDPR-banner) ---
# Dit Cookiebot Domain Group ID (cbid). Tom streng = ingen Cookiebot-script.
NEXT_PUBLIC_COOKIEBOT_ID="c6d79fce-f48c-4891-81bf-8015db0ba290"

# --- E-mail (SPF / DKIM) — sættes hos domæne-udbyder, ikke i Next.js ---
# Resend sender typisk fra dit domæne når EMAIL_FROM er booking@ditdomæne.dk.
# Hos DNS-udbyder (fx one.com, Cloudflare, GratisDNS):
# 1) SPF (TXT på roden @ eller ditdomæne.dk): værdien kommer fra Resend — kopier 1:1 fra dokumentationen:
#    https://resend.com/docs/dashboard/domains/introduction
#    (Indeholder typisk v=spf1 ... include:... — brug præcis den streng Resend viser til dit domæne.)
# 2) DKIM: tilføj de 3 CNAME-records Resend viser (signering).
# 3) DMARC (valgfrit, anbefalet): TXT _dmarc.ditdomæne.dk med v=DMARC1; p=none; (start), senere strammes.
# 4) Verificer domænet i Resend-dashboardet til "Verified".
#
# Facebook Pixel: Opret pixel i Meta Business Suite → Indstillinger → Tilføj datakilde → Web.
# Tilføj domæne og bekræft evt. via DNS eller Meta-fil på sitet.
#
# Link building: sker udenfor koden (partnerskaber, presse, lokale lister, kvalitetsindhold) — ingen env-variabler.

# Hemmelig nøgle til abonnementskalender: GET /api/admin/calendar/ics?token=...
ADMIN_ICAL_TOKEN="generer-en-lang-tilfaeldig-streng"

# Email (valgfrit — uden nøgle logges bekræftelser kun i dev)
RESEND_API_KEY=""
EMAIL_FROM="Ukrudtfri <booking@ukrudtfri.dk>"

# Påmindelses-mail (ca. 2 t før besøg): kald /api/booking-reminders med Bearer.
# På Vercel: sæt CRON_SECRET i projektet — Cron kalder GET hvert 10. min (se vercel.json).
CRON_SECRET=""
REMINDER_CRON_SECRET=""

# OSM Nominatim (anbefalet — identificerer din app)
NOMINATIM_CONTACT_EMAIL="din@email.dk"

# Seed (kun til første oprettelse af admin)
BOOTSTRAP_ADMIN_EMAIL="admin@ukrudtfri.dk"
BOOTSTRAP_ADMIN_PASSWORD="SkiftMig123!"
